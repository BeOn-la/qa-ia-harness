# Copia o sincroniza desde qa-sql-testing-framework (ver tools/Init-SqlProfilesFromSqlFramework.ps1).
# El harness NO lee este archivo automaticamente: usa tools/Invoke-QAProfile.ps1.

MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_SERVER=localhost
MSSQL_DATABASE=qa_db
MSSQL_TRUSTED_CONNECTION=false
MSSQL_USER=qa_user
MSSQL_PASSWORD=
MSSQL_AUTHENTICATION=SqlPassword
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_LOGIN_TIMEOUT=15
MSSQL_QUERY_TIMEOUT=120
MSSQL_DEFAULT_SCHEMA=dbo

# Perfil activo (informativo): local | test | prod
QA_DB_PROFILE=local
