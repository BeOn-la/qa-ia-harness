{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "results v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "control_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "preflight",
        "setup",
        "execute",
        "cleanup"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped",
              "blocked",
              "not_run",
              "cancelled",
              "incomplete"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "control_id",
    "phase",
    "tests"
  ],
  "additionalProperties": false
}
